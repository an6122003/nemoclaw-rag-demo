{
  "agents": {
    "defaults": {
      "model": {
        "primary": "inference/qwen3:8b"
      },
      "timeoutSeconds": 600,
      "skipBootstrap": true,
      "thinkingDefault": "off",
      "compaction": {
        "mode": "safeguard",
        "timeoutSeconds": 120,
        "maxHistoryShare": 0.35,
        "recentTurnsPreserve": 1,
        "qualityGuard": {
          "enabled": true,
          "maxRetries": 0
        },
        "notifyUser": true,
        "truncateAfterCompaction": true
      },
      "workspace": "/sandbox/.openclaw/workspace",
      "memorySearch": {
        "enabled": true,
        "provider": "ollama-mem",
        "model": "qwen3-embedding:4b"
      }
    },
    "list": [
      {
        "id": "main",
        "default": true
      }
    ]
  },
  "models": {
    "mode": "merge",
    "providers": {
      "inference": {
        "baseUrl": "https://inference.local/v1",
        "apiKey": "unused",
        "api": "openai-completions",
        "timeoutSeconds": 600,
        "models": [
          {
            "compat": {
              "supportsStore": false
            },
            "id": "qwen3:8b",
            "name": "inference/qwen3:8b",
            "reasoning": false,
            "input": [
              "text"
            ],
            "cost": {
              "input": 0,
              "output": 0,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "contextWindow": 131072,
            "maxTokens": 4096
          }
        ]
      },
      "ollama-mem": {
        "api": "openai-completions",
        "baseUrl": "http://host.openshell.internal:11434/v1",
        "apiKey": "ollama",
        "models": [
          {
            "id": "qwen3-embedding:4b",
            "name": "Qwen3 embedding 4B"
          }
        ]
      }
    }
  },
  "channels": {
    "defaults": {},
    "telegram": {
      "enabled": false
    },
    "discord": {
      "enabled": false
    },
    "openclaw-weixin": {
