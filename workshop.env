# ============================================================================
#  Workshop settings — read by setup.sh, start.sh and the workshop app.
#  Cấu hình workshop — dùng chung cho setup.sh, start.sh và ứng dụng.
#
#  You do not need to change anything here. Every value can also be overridden
#  from the environment, e.g.  CHAT_MODEL=qwen3.6:35b ./setup.sh
# ============================================================================

# --- Models served by Ollama -------------------------------------------------
# Chat + agent model: NVIDIA Nemotron 3.5 Lightning, the model the workshop is
# required to use (a 33B mixture-of-experts model with 3B active, tool calling,
# thinking switched off by the labs; about 25 GB to download). It also becomes
# the NemoClaw sandbox's inference model. Previously qwen3.6:35b, which works too.
CHAT_MODEL=nemotron-3.5-lightning:30b-a3b

# A second model participants can pick themselves in OpenClaw's chat during
# the challenge (type /model qwen, and /model nemotron to go back). The labs
# keep using CHAT_MODEL. About 24 GB to download; leave empty to skip it.
EXTRA_CHAT_MODEL=qwen3.6:35b

# Context window of the chat models (tokens), stored with each model in Ollama
# and given to OpenClaw: room for long coding sessions. 262144 is Qwen 3.6's
# maximum; measured on a 128 GB Spark, Nemotron needs about 26 GB with it and
# Qwen about 30 GB, both loaded at once leave room for the labs. (1048576,
# Nemotron's own maximum, took about 41 GB and makes long turns slow.)
CHAT_CONTEXT=262144
# Longest reply OpenClaw asks for (a whole source file in one tool call).
CHAT_MAX_TOKENS=16384

# Embedding model for RAG (Hands-on 2). The pre-built index in
# hands-on-2-rag/index/ was built with this exact model — change both together.
EMBED_MODEL=qwen3-embedding:4b

# --- Hands-on 1: fine-tuning ----------------------------------------------------
# Hugging Face model that is fine-tuned with LoRA, and the same model from the
# Ollama library, used as the "before" side of the comparison.
LAB1_BASE_HF=Qwen/Qwen2.5-1.5B-Instruct
LAB1_BASE_OLLAMA=qwen2.5:1.5b-instruct
# Name the fine-tuned model gets in Ollama.
LAB1_TUNED_MODEL=aurora-assistant
# NVIDIA NGC PyTorch container used for training (the DGX Spark playbooks use it).
LAB1_BASE_IMAGE=nvcr.io/nvidia/pytorch:25.11-py3
LAB1_IMAGE=workshop-finetune:latest

# --- Enterprise batch demos (tab 05) ------------------------------------------
# Batch jobs (2,400 customer messages, 1,000 scanned invoices) run on vLLM,
# which works on dozens of items at once; Ollama answers one at a time. The
# engine is NVIDIA's vLLM container with NVIDIA's NVFP4 build of Qwen 3.6
# (reads images too), pinned to the versions checked on a DGX Spark. About
# 12 GB + 22 GB to download. The app starts it when a batch runs and stops it
# after BATCH_IDLE_MINUTES without work, giving the memory back to the labs.
BATCH_IMAGE=nvcr.io/nvidia/vllm:26.05.post1-py3
BATCH_MODEL=nvidia/Qwen3.6-35B-A3B-NVFP4
BATCH_MODEL_REVISION=491c2f1ea524c639598bf8fa787a93fed5a6fbce
# Share of the machine's memory the engine may use (about 32 GB; less when
# memory is busy, never below about 27 GB).
BATCH_GPU_MEMORY=0.26
BATCH_PORT=8100
BATCH_IDLE_MINUTES=30
# Call-centre demo: speech-to-text with VinAI's PhoWhisper (BSD-3, about 3 GB),
# run in the same vLLM container; 300 sample calls are spoken by Piper
# (piper-tts, GPL-3.0, in its own .run/tts-venv) with the vi_VN vais1000 voice
# (VAIS-1000 corpus, CC BY 4.0).
ASR_MODEL=vinai/PhoWhisper-medium
ASR_MODEL_REVISION=55a7e3eb6c906de891f8f06a107754427dd3be79
PIPER_VERSION=1.8.0
VOICE_REVISION=c10ece1aade47bb51c153c893d14e5bf8e5b7117

# --- NemoClaw ------------------------------------------------------------------
# The workshop gets its own sandbox on its own OpenShell gateway, so it never
# collides with a NemoClaw sandbox that already exists on the machine. NVIDIA's
# Express Install, for example, creates "my-assistant" on gateway 8080, and a
# gateway serves only one model route.
SANDBOX=dgx-workshop
NEMOCLAW_GATEWAY_PORT=8990
# NemoClaw release installed on a machine that has none (the version the labs
# were verified with). An existing NemoClaw install is used as it is.
NEMOCLAW_VERSION=v0.0.124
# The OpenClaw agent that runs Hands-on 3 inside the sandbox.
AGENT_ID=analyst
# NemoClaw forwards the sandbox's OpenClaw gateway to this host port.
GATEWAY_URL=http://127.0.0.1:18789

# --- Ports -----------------------------------------------------------------------
OLLAMA_URL=http://127.0.0.1:11434
HUB_PORT=8090
# Ollama context window. OpenClaw's agent prompt plus tool definitions needs far
# more than Ollama's small default; NemoClaw keeps any value at or above its
# own floor.
OLLAMA_CONTEXT_LENGTH=32768
